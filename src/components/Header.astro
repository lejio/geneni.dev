---
import NavBar from "./NavBar.astro"
import LangPercentage from "./LangPercentage"
import ThemeToggle from "./ThemeToggle"
const currentPath = Astro.url.pathname;
---

<header class=" max-w-[1920px] max-h-[1080px] w-full pt-2 h-auto flex justify-between align-middle items-center gap-3">
    <NavBar />
    <div class="flex justify-end align-middle items-center gap-3">
        <ThemeToggle client:load />
        <div class="hidden sm:block">
            {currentPath == "/"? <LangPercentage client:load />: null}
        </div>
    </div>
</header>