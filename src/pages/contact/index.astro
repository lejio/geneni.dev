---
import Layout from "../Layout.astro";
import SendEmail from "../../components/SendEmail";
import { PUBLIC_TURNSTILE_SITE_KEY } from "astro:env/client";

const siteKey = PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<Layout title="Gene Ni | Contact">
  <div
    class="w-full min-h-[75vh] flex flex-col justify-center items-center gap-6 px-3 py-10"
  >
    <div class="flex max-w-lg flex-col items-center gap-2 text-center">
      <h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
        Contact me
      </h1>
      <p class="text-sm text-neutral-600 dark:text-neutral-400">
        Have a question, opportunity, or project idea? Send a message and I&apos;ll
        get back to you.
      </p>
    </div>

    <SendEmail client:load siteKey={siteKey} />
  </div>
</Layout>
